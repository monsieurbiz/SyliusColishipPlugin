{% set form = hookable_metadata.context.form %}
{% set type = hookable_metadata.context.type|default(null) %}

<div class="row">
    <div class="col-12 col-md-6">{{ form_row(form.postcode, sylius_test_form_attribute(type ~ 'postcode')) }}</div>
    <div class="col-12 col-md-6">{{ form_row(form.city, sylius_test_form_attribute(type ~ 'city')) }}</div>
</div>
