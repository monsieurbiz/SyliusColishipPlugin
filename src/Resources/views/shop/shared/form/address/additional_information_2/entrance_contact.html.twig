{% set form = hookable_metadata.context.form %}
{% set type = hookable_metadata.context.type|default(null) %}

<div class="col-12 col-md-6">
    <div class="row">
        <div class="col-6 col-md-4">
            {{ form_row(form.doorCode1, sylius_test_form_attribute(type ~ 'doorCode1')) }}
        </div>
        <div class="col-6 col-md-4 text-nowrap">
            {{ form_row(form.doorCode2, sylius_test_form_attribute(type ~ 'doorCode2')) }}
        </div>
        <div class="col-12 col-md-4">
            {{ form_row(form.intercom, sylius_test_form_attribute(type ~ 'intercom')) }}
        </div>
    </div>
</div>
