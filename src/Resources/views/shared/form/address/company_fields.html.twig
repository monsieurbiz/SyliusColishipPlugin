{% set form = hookable_metadata.context.form %}
{% set type = hookable_metadata.context.type|default(null) %}

<div class="row">
    <div class="col-12 col-md-6">{{ form_row(form.company, sylius_test_form_attribute(type ~ 'company')) }}</div>
    <div class="col-12 col-md-6">{{ form_row(form.service, sylius_test_form_attribute(type ~ 'service')) }}</div>
</div>
